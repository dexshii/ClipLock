# Public hostnames (DNS must point at this machine; Caddy obtains TLS certificates).
CLIPLOCK_DOMAIN=clips.example.com
STORAGE_DOMAIN=storage.clips.example.com

# Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
MEDIA_SIGNING_SECRET=change-me-to-at-least-32-random-characters

# Object storage. With the bundled MinIO these become its root credentials.
S3_ACCESS_KEY_ID=cliplock
S3_SECRET_ACCESS_KEY=change-me-too
S3_BUCKET=cliplock
# For external S3-compatible storage, set these and remove the minio services:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto

ALLOW_REGISTRATION=true
WORKER_CONCURRENCY=1
