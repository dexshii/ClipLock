{
  "name": "@cliplock/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/app.js",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@cliplock/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
