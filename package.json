{
  "name": "cliplock",
  "private": true,
  "description": "ClipLock — Capture it. Keep it. Open-source gaming clip recorder and sharing platform.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:installer": "node scripts/build-installer.mjs",
    "test:packaging": "node --test scripts/package-windows.test.mjs",
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./services/** --filter ./apps/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:desktop": "pnpm --filter @cliplock/desktop tauri dev",
    "dev:api": "pnpm --filter @cliplock/api dev",
    "dev:worker": "pnpm --filter @cliplock/worker dev",
    "dev:web": "pnpm --filter @cliplock/web dev",
    "db:migrate": "pnpm --filter @cliplock/api migrate"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
